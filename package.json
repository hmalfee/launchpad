{
    "name": "launchpad",
    "displayName": "Launchpad",
    "description": "Build your own buttons for the status bar, sidebar and editor title bar. Global or per project, managed from a visual UI.",
    "version": "0.1.0",
    "private": true,
    "publisher": "local",
    "engines": {
        "vscode": "^1.85.0"
    },
    "main": "./dist/extension.cjs",
    "activationEvents": [
        "onStartupFinished"
    ],
    "scripts": {
        "build": "tsdown && pnpm build:webview",
        "build:webview": "vite build --config webview/vite.config.ts",
        "dev:webview": "vite build --watch --config webview/vite.config.ts",
        "typecheck": "tsc --noEmit && tsc --noEmit -p webview"
    },
    "devDependencies": {
        "@radix-ui/react-dialog": "^1.1.0",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-select": "^2.1.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-switch": "^1.1.0",
        "@radix-ui/react-tabs": "^1.1.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/vscode": "^1.85.0",
        "@vitejs/plugin-react": "^5.0.0",
        "@vscode/codicons": "^0.0.36",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "tsdown": "^0.23.2",
        "typescript": "^5.5.0",
        "vite": "^7.0.0"
    },
    "contributes": {
        "configuration": {
            "title": "Launchpad",
            "properties": {
                "launchpad.items": {
                    "type": "array",
                    "default": [],
                    "scope": "window",
                    "items": {
                        "type": "object"
                    },
                    "markdownDescription": "Launchers created in the Launchpad manager. Set in user settings for global launchers, or in workspace settings for project launchers. Use **Launchpad: Open Manager** to edit them visually."
                }
            }
        },
        "commands": [
            {
                "command": "launchpad.openManager",
                "title": "Open Manager",
                "category": "Launchpad",
                "icon": "$(settings-gear)"
            },
            {
                "command": "launchpad.newLauncher",
                "title": "New Launcher",
                "category": "Launchpad",
                "icon": "$(add)"
            },
            {
                "command": "launchpad.run",
                "title": "Run Launcher…",
                "category": "Launchpad",
                "icon": "$(play)"
            },
            {
                "command": "launchpad.runItem",
                "title": "Run",
                "category": "Launchpad",
                "icon": "$(play)"
            },
            {
                "command": "launchpad.editItem",
                "title": "Edit",
                "category": "Launchpad",
                "icon": "$(edit)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "launchpad",
                    "title": "Launchpad",
                    "icon": "media/activity.svg"
                }
            ]
        },
        "views": {
            "launchpad": [
                {
                    "id": "launchpad.sidebar",
                    "name": "Launchers"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "launchpad.sidebar",
                "contents": "Nothing here yet.\nLaunchers created in the manager show up here when you turn on the Sidebar option.\n[Create a launcher](command:launchpad.newLauncher)\n[Open manager](command:launchpad.openManager)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "launchpad.newLauncher",
                    "when": "view == launchpad.sidebar",
                    "group": "navigation@1"
                },
                {
                    "command": "launchpad.openManager",
                    "when": "view == launchpad.sidebar",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "launchpad.runItem",
                    "when": "view == launchpad.sidebar && viewItem == launcher",
                    "group": "inline@1"
                },
                {
                    "command": "launchpad.editItem",
                    "when": "view == launchpad.sidebar && viewItem == launcher",
                    "group": "inline@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "launchpad.runItem",
                    "when": "false"
                },
                {
                    "command": "launchpad.editItem",
                    "when": "false"
                }
            ],
            "editor/title": []
        }
    }
}
